# Copia este archivo a .env (nunca subas .env). Cadenas en console.neon.tech → proyecto horex → Connect.
# Siempre sslmode=verify-full.

# ── Rama "production" de Neon ──
# Dueño, directa (sin -pooler): migraciones y alta de usuarios (npm run db:migrar / db:crear-usuario -- --destino produccion).
DATABASE_URL_DIRECTA=postgresql://neondb_owner:CONTRASENA@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Rol horex_api, con pooler: la escribe `npm run db:rol-api -- --destino produccion`; va en Railway como DATABASE_URL de horex-api.
DATABASE_URL_API=postgresql://horex_api:CONTRASENA@ep-xxxx-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# ── Rama "desarrollo" de Neon (datos de la demo; pruebas de base y API) ──
DATABASE_URL_DESARROLLO=postgresql://neondb_owner:CONTRASENA@ep-yyyy-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DATABASE_URL_DESARROLLO_DIRECTA=postgresql://neondb_owner:CONTRASENA@ep-yyyy.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# La escribe `npm run db:rol-api -- --destino desarrollo`; la API local (npm run dev:api) la usa si no hay DATABASE_URL.
DATABASE_URL_DESARROLLO_API=postgresql://horex_api:CONTRASENA@ep-yyyy-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Contraseña de los usuarios de prueba (*@prueba.horex); la genera `npm run db:semilla-demo -- --destino desarrollo`.
CONTRASENA_PRUEBA=

# ── API ──
JWT_SECRETO=cadena-aleatoria-de-al-menos-32-caracteres
PORT=8080
TZ=America/Merida
