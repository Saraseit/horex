# Copia este archivo a .env (nunca subas .env).
# Neon, proyecto "horex", rama production. Cadenas en console.neon.tech → Connect.
# Con pooler (-pooler en el host): la usa la API.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Directa (sin -pooler): migraciones y scripts.
DATABASE_URL_DIRECTA=postgresql://USUARIO:CONTRASENA@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# API
JWT_SECRETO=cadena-aleatoria-larga
PORT=8080
TZ=America/Merida
